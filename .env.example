# ─────────────────────────────────────────────────────────────────────────────
# Paraph – Konfiguration. scripts/install.sh legt daraus .env an (Rechte 0600).
# Schlüssel stehen NICHT hier, sondern als Docker-Secrets in secrets/ (master.key, backup_passphrase).
# ─────────────────────────────────────────────────────────────────────────────

# Öffentliche Adresse (immer https:// im Produktivbetrieb)
APP_URL=https://sign.kanzlei.example
# Nur mit Profil „caddy“: Domain für das automatische Zertifikat und Kontaktadresse für Let's Encrypt
DOMAIN=sign.kanzlei.example
ACME_EMAIL=it@kanzlei.example
# Reverse Proxy: „true“ = genau ein vertrauenswürdiger Proxy-Hop (Caddy, nginx). Alternativ Anzahl der Hops
# oder Proxy-Adressen/Netze, z. B. 172.16.0.0/12. Ohne Proxy: false.
TRUST_PROXY=true
# Ersteinrichtung: Code, der beim ersten Aufruf von /setup verlangt wird (danach wirkungslos)
SETUP_CODE=

# ── E-Mail (Pflicht) ─────────────────────────────────────────────────────────
# smtps://benutzer:passwort@smtp.example.org:465  (TLS) oder smtp://…:587 (STARTTLS wird erzwungen)
# Sonderzeichen im Passwort URL-kodieren (z. B. @ → %40).
SMTP_URL=
MAIL_FROM="Kanzlei Muster <signatur@kanzlei.example>"

# ── Nachweis ─────────────────────────────────────────────────────────────────
# RFC-3161-Zeitstempeldienst (dringend empfohlen): Siegel PAdES-B-T und externe Verankerung der Audit-Ketten.
# Übertragen wird nur ein Hash. Beispiele: Zeitstempeldienst Ihres Vertrauensdiensteanbieters (D-Trust, Bundesdruckerei,
# SwissSign …) oder https://freetsa.org/tsr (kostenlos, ohne Gewähr).
TSA_URL=
# Mit TSA_URL Pflicht: Zertifikat des Zeitstempeldienstes (PEM) als Docker-Secret secrets/tsa_ca.pem
# (install.sh fragt es ab; Compose setzt TSA_CA_FILE=/run/secrets/tsa_ca)
# Abstand der Verankerung in Minuten (Standard 60)
ANCHOR_INTERVAL_MINUTES=60

# ── Anmeldung per OIDC (optional, z. B. authentik) ──────────────────────────
# Einrichtung: docs/handbuch/03-konfiguration.md
# authentik: OAuth2/OpenID-Provider (confidential, Grant type authorization_code, Signing Key setzen),
# Redirect-URI ${APP_URL}/api/auth/oidc/callback, Scopes openid + profile + E-Mail-Mapping mit email_verified.
# Issuer z. B. https://auth.kanzlei.example/application/o/paraph/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=authentik
# Scopes (bei authentik enthält „profile“ den Claim „groups“)
OIDC_SCOPES=openid email profile
# Nur Mitglieder dieser Gruppen (kommagetrennt, Claim „groups“); leer = alle
OIDC_ALLOWED_GROUPS=
OIDC_AUTO_CREATE_USERS=false
# Neue SSO-Konten treten der ältesten Organisation mit dieser Rolle bei (nur member oder viewer); leer = nur per Einladung
OIDC_DEFAULT_ROLE=
# Konten auch ohne email_verified=true per E-Mail verknüpfen – nur, wenn allein die Verwaltung E-Mail-Adressen im IdP pflegt
OIDC_TRUST_EMAIL=false

# ── SMS-Gateway (optional; JSON POST {to,text,sender}; Kosten beim Anbieter) ──
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# ── S3-kompatible Ablage (optional; Inhalte werden vorher verschlüsselt) ─────
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Nur bei temporären Zugangsdaten (STS)
S3_SESSION_TOKEN=
# Pfadstil (endpoint/bucket/objekt); Standard: true mit S3_ENDPOINT, sonst false (AWS)
S3_FORCE_PATH_STYLE=
# Schlüsselpräfix im Bucket, z. B. paraph/ (leer = Bucket-Wurzel)
S3_PREFIX=

# ── Webhooks ─────────────────────────────────────────────────────────────────
# Webhooks an interne Systeme (z. B. n8n im LAN) erlauben: Hostnamen/IPs kommagetrennt
WEBHOOK_ALLOW_HOSTS=

# ── Sicherung ────────────────────────────────────────────────────────────────
# Verschlüsselt nach BACKUP_PATH (Host). Mit secrets/backup_passphrase enthält jede Sicherung den Hauptschlüssel.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
BACKUP_PATH=./backups

# ── Monitoring (optional) ────────────────────────────────────────────────────
# Prometheus-Endpunkt /metrics, nur mit „Authorization: Bearer <METRICS_TOKEN>“
METRICS_TOKEN=

MAX_UPLOAD_MB=25
LOG_LEVEL=info
