# Öffentliche Adresse (mit https:// hinter dem Reverse Proxy)
APP_URL=https://sign.kanzlei.example
# Reverse Proxy setzt X-Forwarded-For → echte Client-IP im Audit-Trail
TRUST_PROXY=true
# Ersteinrichtung: Code, der beim ersten Aufruf von /setup verlangt wird (danach wirkungslos)
SETUP_CODE=
# E-Mail-Versand, z. B. smtps://benutzer:passwort@smtp.example.org:465
SMTP_URL=
MAIL_FROM="Kanzlei Muster <signatur@kanzlei.example>"
# Optional: RFC-3161-Zeitstempeldienst für das Plattformsiegel (z. B. https://freetsa.org/tsr) – Daten verlassen den Server: nur ein Hash
TSA_URL=
# Optional: Anmeldung per OIDC (z. B. authentik)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=authentik
OIDC_AUTO_CREATE_USERS=false
# Optional: SMS-Gateway (JSON POST {to,text,sender}); Kosten beim Anbieter
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
# Optional: S3-kompatible Ablage statt lokalem Volume (Inhalte werden vorher verschlüsselt)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Nur bei temporären Zugangsdaten (STS)
S3_SESSION_TOKEN=
# Pfadstil (endpoint/bucket/objekt); Standard: true mit S3_ENDPOINT, sonst false (AWS)
S3_FORCE_PATH_STYLE=
# Schlüsselpräfix im Bucket, z. B. paraph/ (leer = Bucket-Wurzel)
S3_PREFIX=
# Webhooks an interne Systeme (z. B. n8n im LAN) erlauben: Hostnamen/IPs kommagetrennt
WEBHOOK_ALLOW_HOSTS=
# Automatische Sicherung
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
MAX_UPLOAD_MB=25
LOG_LEVEL=info
