    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "asn1js": "^3.1.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "nodemailer": "^10.2.0",
    "openid-client": "^6.8.8",
    "otpauth": "^9.5.2",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pino": "^10.4.0",
    "pkijs": "^3.4.3",
    "pngjs": "^7.0.0",
    "read-excel-file": "^9.3.12",
    "undici": "^8.12.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/homemade-apple": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/la-belle-aurore": "^5.3.0",
    "@fontsource/mrs-saint-delafield": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-query": "^5.104.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
